---
// Ícones da página de vendas original (Hotmart Pages).
interface Props {
  name: 'arrow' | 'down' | 'shield' | 'play' | 'whatsapp' | 'devices' | 'lock';
}

const { name } = Astro.props;
---

{name === 'arrow' && (
  <svg class="lrx-icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"></path></svg>
)}
{name === 'down' && (
  <svg class="lrx-icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"></path></svg>
)}
{name === 'shield' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9S4 17 4 12V6l8-3Z"></path><path d="m8 12 3 3 5-6"></path></svg>
)}
{name === 'play' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3 21 12 6 21Z"></path></svg>
)}
{name === 'whatsapp' && (
  <svg class="lrx-community-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l1.7-5.4A8.5 8.5 0 1 1 21 11.5Z"></path><path d="M8 8c0 4 2 6 6 7l2-2-3-2-1 1-2-2 1-1-2-2-1 1Z"></path></svg>
)}
{name === 'devices' && (
  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="6" width="33" height="24" rx="2"></rect><path d="M3 25h25M19 30v7M11 37h17"></path><rect x="29" y="18" width="15" height="25" rx="2"></rect><path d="M35 39h3"></path></svg>
)}
{name === 'lock' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
)}
