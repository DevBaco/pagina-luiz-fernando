---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { products } from '../../data/site';

const courseIncludes = [
  'Fundamentos da massoterapia Ayurvédica',
  'Formação em massagem Abhyanga',
  'Técnica, escuta e presença no toque',
  'Prática para atender com segurança',
];
---

<BaseLayout
  title="Cursos e Formações | Luiz Reis"
  description="Formação em massoterapia Ayurvédica e massagem Abhyanga, e-book de culinária Ayurvédica e cursos de Ayurveda."
>
  <PageHeader
    title="Cursos e Formações"
    eyebrow="Ayurveda, Astrologia Védica e toque terapêutico"
    backgroundImage="/images/page-header-cursos-e-formacoes.webp"
  />

  <section class="our-pricing light-section">
    <div class="container">
      <div class="row section-row align-items-center">
        <div class="col-xl-7">
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Curso em destaque</span>
            <h2 class="text-anime-style-3" data-cursor="-opaque">Formação em Massoterapia Ayurvédica e Massagem Abhyanga</h2>
          </div>
        </div>
        <div class="col-xl-5">
          <div class="section-title-content wow fadeInUp" data-wow-delay="0.2s">
            <p>Uma formação completa para quem deseja aprender a massagem Abhyanga e levar o toque terapêutico Ayurvédico para a sua prática. Curso disponível na plataforma Hotmart.</p>
          </div>
        </div>
      </div>

      <div class="row align-items-stretch course-highlight">
        <div class="col-lg-6">
          <figure class="course-highlight-image image-anime wow fadeInUp">
            <img src="/images/vendas/curso-abhyanga-hotmart.webp" alt="Curso de Massoterapia Ayurvédica — Luizz_C_Reeiss, Medicina Ayurveda" width="610" height="454" />
            <figcaption>Curso online · Massagem Abhyanga</figcaption>
          </figure>
        </div>
        <div class="col-lg-6 pricing-single">
          <div class="pricing-item highlighted-box wow fadeInUp" data-wow-delay="0.2s">
            <div class="pricing-item-header course-card-header">
              <div class="icon-box"><img src="/images/icon-pricing-2.svg" alt="" /></div>
              <div class="pricing-item-content">
                <span class="pricing-item-title">Massoterapia Ayurvédica</span>
                <p>Formação em massagem Abhyanga com fundamentos, técnica e prática.</p>
              </div>
            </div>
            <div class="pricing-item-body">
              <div class="pricing-item-body-list">
                <h3>O que você aprende:</h3>
                <ul>
                  {courseIncludes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div class="course-card-footer">
                <div class="pricing-item-btn">
                  <a href={products.abhyanga.path} class="btn-default btn-highlighted">Conhecer a formação</a>
                </div>
                <a
                  class="hotmart-course-brand"
                  href={products.abhyanga.path}
                  aria-label="Conhecer a Formação em Massoterapia Ayurvédica e Massagem Abhyanga"
                >
                  <span>Curso disponível na</span>
                  <img src="/images/hotmart-logo.svg" alt="Hotmart" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="simple-page-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xl-6">
          <figure class="image-anime ebook-cover"><img src="/images/ebook-culinaria-ayurvedica.webp" alt="Capa do e-book Culinária Ayurvédica" width="1079" height="609" /></figure>
        </div>
        <div class="col-xl-6">
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">E-book</span>
            <h2 class="text-anime-style-3" data-cursor="-opaque">{products.culinaria.title}</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">Comer bem não significa sem graça. Um e-book criado com Camila Burgarelli para despertar a sua criatividade na cozinha e aprender, com os conceitos do Ayurveda, formas deliciosas de preparar o seu alimento.</p>
          </div>
          <div class="about-us-btn wow fadeInUp" data-wow-delay="0.3s">
            <a class="btn-default btn-highlighted" href={products.culinaria.path}>Conhecer o e-book</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
